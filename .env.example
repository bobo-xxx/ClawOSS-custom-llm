# ClawOSS Environment — copy to .env and fill in your values
# DO NOT COMMIT .env — it is gitignored

# === LLM Model Configuration ===
# Set LLM_MODEL + corresponding API key to choose your provider.
# Only one provider is needed at a time — comment out the rest.

# Primary model (required)
LLM_MODEL=minimax/MiniMax-M2.7
LLM_API_KEY=your-api-key-here

# Optional: custom API endpoint (needed for SiliconFlow, Volcengine, etc.)
# LLM_BASE_URL=

# Optional: API type override (default: openai-completions)
# LLM_API_TYPE=openai-completions

# Optional: fallback model when primary fails
# LLM_FALLBACK_MODEL=
# LLM_FALLBACK_API_KEY=

# Cost configuration (USD per million tokens — used for budget tracking)
# If omitted, defaults from cost-models.ts are used
# LLM_INPUT_COST=1.0
# LLM_OUTPUT_COST=8.0

# Model limits
# LLM_CONTEXT_WINDOW=204000
# LLM_MAX_TOKENS=131000

# === Provider-specific API Keys ===
# Fill in only the providers you use. LLM_MODEL determines which one is active.

# MiniMax (direct API, https://api.minimaxi.com/v1)
MINIMAX_API_KEY=your-minimax-key-here

# DeepSeek (https://api.deepseek.com)
DEEPSEEK_API_KEY=your-deepseek-key-here

# Volcengine / Kimi K2.5 (https://ark.cn-beijing.volces.com/api/coding/v3)
VOLCENGINE_API_KEY=your-volcengine-key-here

# SiliconFlow (https://api.siliconflow.cn/v1)
SILICONFLOW_API_KEY=your-siliconflow-key-here

# --- Direct API Providers (no proxy) ---

# OpenAI GPT-4o (https://platform.openai.com)
# OPENAI_API_KEY=sk-your-openai-key-here
# LLM_BASE_URL=https://api.openai.com/v1

# Anthropic Claude (https://console.anthropic.com)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_API_TYPE=anthropic-messages

# Google Gemini (https://aistudio.google.com/app/apikey)
# GOOGLE_API_KEY=your-google-key-here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Mistral (https://console.mistral.ai)
# MISTRAL_API_KEY=your-mistral-key-here
# LLM_BASE_URL=https://api.mistral.ai/v1

# Groq (https://console.groq.com)
# GROQ_API_KEY=gsk-your-groq-key-here
# LLM_BASE_URL=https://api.groq.com/openai/v1

# === Budget ===
# Max total USD to spend before the agent enters idle mode
BUDGET_CAP_USD=1.0
# Optional: daily budget override (if not set, uses BUDGET_CAP_USD / 30)
# DAILY_BUDGET_USD=

# === Required (Agent) ===
GITHUB_TOKEN=ghp_your-token-here

# === Dashboard Telemetry ===
DASHBOARD_URL=https://dashboard-bobo.online
CLAW_API_KEY=your-shared-secret-here

# === GitHub Identity ===
GITHUB_USERNAME=your-github-username
GITHUB_EMAIL=your-email@users.noreply.github.com

# === Dashboard Database (for local dev only, Vercel has these set) ===
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
